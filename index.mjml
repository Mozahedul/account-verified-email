<mjml>
  <mj-head>
    <!-- Email Subject Preview -->
    <mj-preview>
      Limited-time offer on handcrafted ceramic mugs. Shop now before it's gone.
    </mj-preview>

    <!-- Breakpoint -->
    <mj-breakpoint width="480px" />

    <!-- Email Title -->
    <mj-title>Obsidian Ceramic Mug – Special Offer</mj-title>

    <!-- Google Font -->
    <mj-font
      name="Open Sans"
      href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap"
    />

    <!--
    ================================================
      COLOR SYSTEM
    ================================================

      LIGHT MODE
      ----------
      Email outer bg        → #f4f4f4
      Section bg            → #ffffff
      Card bg               → #f8f8f8
      Border                → #e8e8e8
      Heading               → #111111
      Subheading            → #444444
      Body text             → #666666
      Muted                 → #888888
      Footer text           → #999999

      DARK MODE
      ----------
      Email outer bg        → #111111
      Section bg            → #1a1a1a
      Card bg               → #222222
      Border                → #333333
      Heading               → #f0f0f0
      Subheading            → #cccccc
      Body text             → #aaaaaa
      Muted                 → #888888
      Footer text           → #666666

      ACCENT (both modes)
      -------------------
      Primary green         → #1a5c38
      Amber                 → #c97d2e

      DIVIDERS
      --------
      Light                 → #e8e8e8  (dark: #333333)
      Strong                → #cccccc  (dark: #444444)
    ================================================
    -->
    <!-- Global Attributes -->
    <mj-attributes>
      <!-- Entire Email -->
      <mj-all
        font-family="'Open Sans', Georgia, 'Times New Roman', Arial, serif"
        color="#444444"
        line-height="1.5"
      />

      <!-- Body -->
      <mj-body background-color="#f4f4f4" />

      <!-- Sections -->
      <mj-section padding="0" background-color="#ffffff" />

      <!-- Columns -->
      <mj-column padding="0" />

      <!-- Text -->
      <mj-text
        padding="0"
        font-size="16px"
        line-height="24px"
        color="#444444"
      />

      <!-- Buttons — primary default -->
      <mj-button
        border-radius="4px"
        font-size="14px"
        font-weight="600"
        inner-padding="14px 28px"
        padding="0"
        background-color="#111111"
        color="#ffffff"
      />

      <!-- Images -->
      <mj-image padding="0" border="0" fluid-on-mobile="true" />

      <!-- Divider -->
      <mj-divider
        border-style="solid"
        border-color="#e8e8e8"
        border-width="1px"
        width="100%"
        align="left"
        padding="15px 0"
      />
    </mj-attributes>

    <!-- STYLE BLOCK 1: Inlined regular styles -->
    <mj-style inline="inline">
      a {
        text-decoration: none;
      }
      img {
        display: block;
        border: 0;
        outline: none;
        text-decoration: none;
      }
      p {
        margin: 0;
        padding: 0;
      }
    </mj-style>

    <!-- Raw meta tags -->
    <mj-raw>
      <meta charset="UTF-8" /> <meta http-equiv="X-UA-Compatible"
      content="IE=edge" /> <meta name="viewport" content="width=device-width,
      initial-scale=1.0" /> <meta name="format-detection" content="telephone=no,
      date=no, address=no, email=no, url=no" /> <meta
      name="x-apple-disable-message-reformatting" /> <meta
      http-equiv="List-Unsubscribe"
      content="<mailto:unsubscribe@example.com?subject=unsubscribe>,
      <https://example.com/unsubscribe>" />
    </mj-raw>
  </mj-head>

  <mj-body width="600px" background-color="#f4f4f4">
    <!-- ============================================================ -->
    <!-- LOGO                                                          -->
    <!-- ============================================================ -->
    <mj-section background-color="#f2f8f3">
      <mj-column vertical-align="top">
        <mj-image
          fluid-on-mobile="false"
          src="https://res.cloudinary.com/ducp0w6mx/image/upload/v1779269539/email-portfolio/account-verified-email/images/logo_zwcsld.png"
          alt="Ultimate Technology Limited"
          href="https://mjml.io/product?utm_source=email&utm_medium=newsletter&utm_campaign=summer_sale"
          padding="16px 0"
          width="120px"
        />
        <mj-image
          fluid-on-mobile="false"
          src="https://res.cloudinary.com/ducp0w6mx/image/upload/v1779269538/email-portfolio/account-verified-email/images/checked_zn4qif.png"
          alt=""
          width="50px"
          padding="20px 0px"
        />
        <!-- Order Summary Title -->

        <mj-text
          font-weight="bold"
          align="center"
          font-size="20px"
          color="#444444"
          text-transform="uppercase"
        >
          <span>Your account</span><br />
          <span>is verified</span>
        </mj-text>
        <mj-text align="center" font-size="14px" line-height="1.4" padding="20px 0">
          <span>Your email has been successfully</spa><br>
          <span>verified. You're allset</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Dashboard Button -->
         <mj-section padding="15px 0px" background-color="#f2f8f3">
           <mj-column>
             <mj-button
               width="220px"
               line-height="1.1"
               font-size="14px"
               background-color="#00906f"
               text-transform="uppercase"
               href="https://taqwaitagency.com"
               inner-padding="12px 0"
             >
               Go to dashboard
             </mj-button>
           </mj-column>
         </mj-section>

         <!-- Footer -->
         <mj-section background-color="#f0f8f4" padding="30px 0">
          <mj-column>
            <mj-text align="center" font-size="13px" font-weight="500">
  Thank you for choosing Finwise.
            </mj-text>
            <!-- Social media icons -->

                <mj-text align="center" padding="20px 0">
                  <a
                    href="https://facebook.com"
                    target="_blank"
                    style="display: inline-block"
                  >
                    <img
                      src="https://res.cloudinary.com/ducp0w6mx/image/upload/v1779120948/email-portfolio/reset-password-email/icons/fb_yl0mxl.png"
                      alt="facebook link"
                      width="28px"
                    />
                  </a>
                  <a
                    href="https://x.com"
                    target="_blank"
                    style="display: inline-block; padding: 0px 15px"
                  >
                    <img
                      src="https://res.cloudinary.com/ducp0w6mx/image/upload/v1779120949/email-portfolio/reset-password-email/icons/twitter_lpre05.png"
                      alt="facebook link"
                      width="28px"
                    />
                  </a>
                  <a
                    href="https://linkedin.com"
                    target="_blank"
                    style="display: inline-block"
                  >
                    <img
                      src="https://res.cloudinary.com/ducp0w6mx/image/upload/v1779120948/email-portfolio/reset-password-email/icons/linkedin_punh68.png"
                      alt="facebook link"
                      width="28px"
                    />
                  </a>
                </mj-text>
          </mj-column>
         </mj-section>
  </mj-body>
</mjml>
